# Force LF line endings for files used on macOS/Linux build servers
* text=auto eol=lf

# Explicitly LF for shell scripts and iOS project files
*.sh text eol=lf
*.rb text eol=lf
*.env text eol=lf
ios/.xcode.env text eol=lf
ios/Podfile text eol=lf
ios/**/*.sh text eol=lf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.a binary
*.xcf binary
